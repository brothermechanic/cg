++# Returns the postfix CMake will insert between a library's base name and its
++# file suffix for the configuration we are generating resource files for.
++#
++# CMake initializes the per-target <CONFIG>_POSTFIX property from the
++# CMAKE_<CONFIG>_POSTFIX variable, so a Debug build configured with
++# -DCMAKE_DEBUG_POSTFIX=_d writes usd_sdf_d.dll to disk rather than
++# usd_sdf.dll.  Anything that needs the real on-disk name of a library, such
++# as the LibraryPath recorded in plugInfo.json, must include this postfix or
++# Plug will fail to load the library at runtime.
++function(_get_library_config_postfix target output)
++    set(postfix "")
++
++    # Single-config generators build the configuration named by
++    # CMAKE_BUILD_TYPE.  Multi-config generators build every configuration in
++    # CMAKE_CONFIGURATION_TYPES out of the same build tree, so there is no
++    # single correct answer at generate time; fall back to the first
++    # configuration and warn, since generated resource files can only be
++    # correct for one of them.
++    if(CMAKE_BUILD_TYPE)
++        set(config "${CMAKE_BUILD_TYPE}")
++    elseif(CMAKE_CONFIGURATION_TYPES)
++        list(GET CMAKE_CONFIGURATION_TYPES 0 config)
++        message(WARNING
++            "Building with a multi-config generator while "
++            "CMAKE_<CONFIG>_POSTFIX is set: generated resource files such as "
++            "plugInfo.json will only reference the '${config}' library names.")
++    else()
++        set(config "")
++    endif()
++
++    if(config)
++        string(TOUPPER "${config}" configUpper)
++        get_target_property(targetPostfix ${target} ${configUpper}_POSTFIX)
++        if(NOT DEFINED targetPostfix OR
++           targetPostfix STREQUAL "targetPostfix-NOTFOUND")
++            # The property carries no value of its own; fall back to the
++            # variable CMake initializes it from.
++            if(DEFINED CMAKE_${configUpper}_POSTFIX)
++                set(targetPostfix "${CMAKE_${configUpper}_POSTFIX}")
++            else()
++                set(targetPostfix "")
++            endif()
++        endif()
++        set(postfix "${targetPostfix}")
++    endif()
++
++    set(${output} "${postfix}" PARENT_SCOPE)
++endfunction() # _get_library_config_postfix
++
++# Sets the <CONFIG>_POSTFIX property of TARGET to POSTFIX for every
++# configuration that can be built from this build tree.  Used to override the
++# global CMAKE_<CONFIG>_POSTFIX for targets whose filename is fully determined
++# by something other than the build configuration, e.g. Python extension
++# modules, which must be named _<module>.pyd or _<module>_d.pyd.
++function(_pxr_set_config_postfix target postfix)
++    foreach(config ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
++        if(config)
++            string(TOUPPER "${config}" configUpper)
++            set_target_properties(${target}
++                PROPERTIES
++                    ${configUpper}_POSTFIX "${postfix}"
++            )
++        endif()
++    endforeach()
++endfunction() # _pxr_set_config_postfix
