++# when it was built statically. Which one is available is a property of the
++# OpenSubdiv installation, not of the USD build, so a Debug tree and a Release
++# tree can easily disagree here.
++#
++# USD's exported targets always refer to the plain names, so alias them onto
++# whichever variant is present. This keeps the names baked into
++# pxrTargets.cmake independent of how OpenSubdiv happened to be built, and it
++# keeps the installed package relocatable: the alias carries no absolute path,
++# it just forwards to the imported target that the find step created.
++#
++# OpenSubdiv must already have been found before including this module. It is
++# included from cmake/defaults/Packages.cmake when USD itself is configured and
++# from pxrConfig.cmake.in when a consumer loads the installed package, in both
++# cases before pxrTargets.cmake is included.
++#
++# Note that add_library(ALIAS) over a non-GLOBAL imported target requires
++# CMake 3.11 or newer; USD requires 3.27.
++
++foreach(_osd_component osdCPU osdGPU)
++    if (NOT TARGET OpenSubdiv::${_osd_component} AND
++        TARGET OpenSubdiv::${_osd_component}_static)
++        add_library(OpenSubdiv::${_osd_component}
++            ALIAS OpenSubdiv::${_osd_component}_static)
++    endif()
++endforeach()
